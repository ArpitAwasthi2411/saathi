<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Settings"
            android:textColor="@color/text"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="48dp">

            <TextView
                style="@style/Label"
                android:layout_marginTop="8dp"
                android:text="1 · Capture from any screen" />

            <TextView
                android:id="@+id/assistStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnAssist"
                style="@style/BtnGhost"
                android:layout_marginTop="12dp"
                android:text="Open assistant settings" />

            <TextView
                style="@style/Label"
                android:text="2 · Gemini API key" />

            <EditText
                android:id="@+id/key"
                style="@style/Input"
                android:hint="Paste your key"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnGetKey"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Get a free key" />

                <TextView
                    android:id="@+id/btnTest"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Test keys" />
            </LinearLayout>

            <TextView
                android:id="@+id/testResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/sub"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                style="@style/Label"
                android:text="Extra models (optional backups)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Open-source models through Groq and OpenRouter. Saathi switches to them when Gemini is busy or over its free limit."
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/keyGroq"
                style="@style/Input"
                android:hint="Groq key"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/modelGroq"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:hint="Groq model"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/keyOpenRouter"
                style="@style/Input"
                android:layout_marginTop="14dp"
                android:hint="OpenRouter key"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/modelOpenRouter"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:hint="OpenRouter model"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <TextView
                style="@style/Label"
                android:text="Gemini model for sorting" />

            <EditText
                android:id="@+id/modelSort"
                style="@style/Input"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <TextView
                style="@style/Label"
                android:text="Gemini model for research (needs free Google Search)" />

            <EditText
                android:id="@+id/modelResearch"
                style="@style/Input"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <TextView
                style="@style/Label"
                android:text="About you (used to score fit)" />

            <EditText
                android:id="@+id/profile"
                style="@style/Input"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="3dp"
                android:hint="Who you are, your skills, projects and what you are looking for"
                android:minLines="5" />

            <TextView
                style="@style/Label"
                android:text="Daily digest hour (0-23)" />

            <EditText
                android:id="@+id/digestHour"
                style="@style/Input"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true" />

            <CheckBox
                android:id="@+id/wifiOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Do the deep research only on Wi-Fi"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                style="@style/Label"
                android:text="Privacy" />

            <CheckBox
                android:id="@+id/lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lock Saathi with fingerprint or screen lock"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Everything is stored only on this phone, keys are encrypted, and nothing is backed up. What you capture is sent to the model provider you chose so it can be read, so don't capture private chats or documents. Banking, payment and password apps are skipped automatically."
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnErase"
                style="@style/BtnGhost"
                android:layout_marginTop="14dp"
                android:text="Erase all saved items and tasks"
                android:textColor="@color/red" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
